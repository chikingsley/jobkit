{
  "modules": [
    {
      "path": "collectors",
      "name": "Board collectors",
      "stage": "collect",
      "status": "active",
      "language": "go",
      "owns": "Scrapes anesl, seriousteachers, eslcafe, ajarn, tefl into .jobkit/jobs.sqlite. Parses each listing into a label/value field map.",
      "target": "collectors"
    },
    {
      "path": "src",
      "name": "Application source",
      "stage": "platform",
      "status": "active",
      "owns": "Three numbered pipeline stages, the database client, the shared contracts they import, and the candidate profile and match types at the root. No React, no HTTP server, no view layer.",
      "target": "src"
    },
    {
      "path": "src/pipeline/01_ingest",
      "name": "Ingest",
      "stage": "01_ingest",
      "status": "active",
      "owns": "Reads the collector ledger, validates each listing, upserts job_listings and job_listing_versions with the source field map, and runs deterministic extraction in the same pass.",
      "target": "src/pipeline/01_ingest"
    },
    {
      "path": "src/pipeline/02_extract",
      "name": "Extract",
      "stage": "02_extract",
      "status": "active",
      "owns": "Turns a listing into structured match facts, then normalises it to the one standard everything downstream reads. Boards publishing a label/value map are read with no model call; anesl is covered at 100 percent of 4,005 listings.",
      "target": "src/pipeline/02_extract"
    },
    {
      "path": "src/pipeline/03_match",
      "name": "Match",
      "stage": "03_match",
      "status": "active",
      "owns": "The one canonical read of the inventory, plus scoring. readCandidates returns every active listing on every board with its best live application route, whether that route is an email address or a platform form, and normalises each row on the way out so nothing downstream sees a stored raw value. rankCandidates orders by pay and keeps listings whose pay the board never stated. Scoring compares a job against a candidate profile, preferences, qualification claims, and converted salary, returning per-criterion match, partial, or conflict.",
      "target": "src/pipeline/03_match"
    },
    {
      "path": "src/features",
      "name": "Shared contracts",
      "stage": "platform",
      "status": "active",
      "owns": "The eleven schema and pure-helper files the three live stages import: job types, economics, content analysis, position variants, protected email, inventory contracts, market segments, profile, preferences, agents.",
      "target": "src/shared"
    },
    {
      "path": "src/db",
      "name": "Database client",
      "stage": "platform",
      "status": "active",
      "owns": "The only module that opens a connection: Drizzle over bun:sqlite, and a schema declaring just the three tables the pipeline reads. The database itself is described by migrations/0000_baseline.sql; this schema is a typed view onto the columns we use, proven against the real baseline by the candidates suite. Adding a table here means the pipeline reads it.",
      "target": "src/db"
    },
    {
      "path": "cli",
      "name": "Quality gates",
      "stage": "ops",
      "status": "active",
      "owns": "Four checks and nothing else: file length, migration triggers that would break the D1 HTTP API, the module accounting in this file, and the test accounting in tests/manifest.jsonc. All four run in bun run check and in CI. No logic lives here; the agent plumbing and inventory commands are quarantined.",
      "target": "cli"
    },
    {
      "path": "migrations",
      "name": "Schema baseline",
      "stage": "platform",
      "status": "active",
      "owns": "One baseline dumped from a verified production restore, plus the seed rows the incremental migrations installed.",
      "target": "src/db/migrations"
    },
    {
      "path": "tests",
      "name": "Test suite",
      "stage": "ops",
      "status": "active",
      "owns": "Rebuilt from scratch alongside the pipeline. Every suite is declared in tests/manifest.jsonc and enforced by check:tests.",
      "target": "tests"
    },
    {
      "path": "docs",
      "name": "Documentation",
      "stage": "ops",
      "status": "active",
      "owns": "Architecture and research write-ups.",
      "target": "docs"
    },
    {
      "path": "old",
      "name": "Quarantine",
      "stage": "ops",
      "status": "dormant",
      "owns": "Everything not reviewed, including the whole front end, the HTTP API and services, and pipeline stages 04 through 07. Excluded from tsconfig, lint, and the test configs, so nothing here can fail a build or be imported by live code. Readmitted one piece at a time, or rewritten with it as reference.",
      "target": "old"
    }
  ]
}
