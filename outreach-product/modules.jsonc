{
  "modules": [
    {
      "path": "collectors",
      "name": "Board collectors",
      "stage": "collect",
      "status": "active",
      "language": "go",
      "owns": "Scrapes anesl, seriousteachers, eslcafe, ajarn, tefl into .jobkit/jobs.sqlite. Parses each listing into a label/value field map.",
      "target": "collectors"
    },
    {
      "path": "src",
      "name": "Application source",
      "stage": "platform",
      "status": "moving",
      "owns": "The pipeline stages plus the schemas and helpers they share. Contains no React app; every view is quarantined.",
      "target": "src"
    },
    {
      "path": "src/pipeline/01_ingest",
      "name": "Ingest",
      "stage": "01_ingest",
      "status": "active",
      "owns": "Reads the collector ledger, validates each listing, upserts job_listings and job_listing_versions with the source field map, and runs deterministic extraction in the same pass.",
      "target": "src/pipeline/01_ingest"
    },
    {
      "path": "src/pipeline/02_extract",
      "name": "Extract",
      "stage": "02_extract",
      "status": "active",
      "owns": "Turns a listing into structured match facts. Boards publishing a label/value map are read with no model call; anesl is covered at 100 percent of 4,005 listings.",
      "target": "src/pipeline/02_extract"
    },
    {
      "path": "src/pipeline/03_match",
      "name": "Match",
      "stage": "03_match",
      "status": "moving",
      "owns": "Scores a job against a candidate profile, preferences, qualification claims, and converted salary, returning per-criterion match, partial, or conflict. Profile is a parameter, so several profiles can be scored against the same jobs. Pulled back from quarantine; no tests yet.",
      "target": "src/pipeline/03_match"
    },
    {
      "path": "src/features",
      "name": "Shared contracts",
      "stage": "platform",
      "status": "moving",
      "owns": "Schemas and pure helpers the pipeline stages share: job types and economics, inventory contracts, profile, preferences, documents, organizations, agents.",
      "target": "src/shared"
    },
    {
      "path": "src/db",
      "name": "Database client",
      "stage": "platform",
      "status": "active",
      "owns": "The only module that opens a connection. Defines the query surface and adapts bun:sqlite to it; D1 satisfies the same interface.",
      "target": "src/db"
    },
    {
      "path": "src/model",
      "name": "Model registry",
      "stage": "platform",
      "status": "active",
      "owns": "One place to choose a model per task type, and one shared OpenAI-compatible call.",
      "target": "src/model"
    },
    {
      "path": "src/lib",
      "name": "Shared utilities",
      "stage": "platform",
      "status": "moving",
      "owns": "Country routing, site origin, and small helpers the stages depend on.",
      "target": "src/shared"
    },
    {
      "path": "worker",
      "name": "Server remnant",
      "stage": "platform",
      "status": "moving",
      "owns": "What the pipeline still reaches into: Drizzle schema, the D1 client, extraction helpers, the application-routes repository, and the match-facts recorder. Everything else is quarantined.",
      "target": "src/db + src/pipeline",
      "language": "typescript"
    },
    {
      "path": "cli",
      "name": "Operator CLI",
      "stage": "platform",
      "status": "moving",
      "owns": "Inventory sync against the collector ledger, the agent client, and the quality gates.",
      "target": "cli"
    },
    {
      "path": "migrations",
      "name": "Schema baseline",
      "stage": "platform",
      "status": "active",
      "owns": "One baseline dumped from a verified production restore, plus the seed rows the incremental migrations installed.",
      "target": "src/db/migrations"
    },
    {
      "path": "tests",
      "name": "Test suite",
      "stage": "ops",
      "status": "active",
      "owns": "Rebuilt from scratch alongside the pipeline. Every suite is declared in tests/manifest.jsonc and enforced by check:tests.",
      "target": "tests"
    },
    {
      "path": "docs",
      "name": "Documentation",
      "stage": "ops",
      "status": "active",
      "owns": "Architecture and research write-ups.",
      "target": "docs"
    },
    {
      "path": "old",
      "name": "Quarantine",
      "stage": "ops",
      "status": "dormant",
      "owns": "Everything not yet reviewed. Excluded from tsconfig, lint, and the test configs, so nothing here can fail a build or be imported by live code. Readmitted one piece at a time.",
      "target": "old"
    }
  ]
}
