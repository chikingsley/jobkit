{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  // Quarantine is kept, not maintained. Nothing there runs or is imported by
  // live code, so it must not be able to fail a build.
  "files": { "includes": ["!old"] },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noVoid": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 500 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["drizzle/meta/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["src/db/schema/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/unit/schema-drift/support.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/routeTree.gen.ts", "worker-configuration.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 15 }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**", "src/hooks/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "off"
          },
          "style": { "useConsistentTypeDefinitions": "off" },
          "suspicious": {
            "noDocumentCookie": "off",
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noLeakedRender": "off",
            "noShadow": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
