{
  "name": "jobkit-outreach-product",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "wrangler types --check && ultracite check && tsc --noEmit && vitest run --config tests/vitest.config.ts",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "dev": "vite",
    "jobkit": "bun --env-file=.dev.vars cli/index.ts",
    "fix": "ultracite fix",
    "inventory:sync": "bun --env-file=.dev.vars cli/index.ts inventory sync",
    "test": "vitest --config tests/vitest.config.ts",
    "test:e2e": "bun tests/e2e/run-maestro.ts",
    "test:run": "vitest run --config tests/vitest.config.ts",
    "types:worker": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.9",
    "@ai-sdk/google": "^4.0.17",
    "@ai-sdk/mistral": "^4.0.10",
    "@ai-sdk/openai-compatible": "^3.0.9",
    "@base-ui/react": "^1.6.0",
    "@cloudflare/vite-plugin": "1.45.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@shadcn/react": "^0.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "ai": "^7.0.26",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.2.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "5.20260718.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "ultracite": "^7.9.4",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  }
}
