{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemId": { "type": "string" },
          "label": {
            "type": "string",
            "enum": [
              "english_teaching",
              "subject_teaching",
              "non_teaching",
              "unclear"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "rationale": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["itemId", "label", "confidence", "rationale", "evidence"]
      }
    }
  },
  "required": ["items"]
}
