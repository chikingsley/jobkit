{
  "suites": [
    {
      "path": "tests/01_ingest/from-ledger.test.ts",
      "stage": "01_ingest",
      "category": "contract",
      "protects": "The path from the collector ledger into the local database, against the real baseline schema: how each board is applied to, that an email address beats an advert url, that a board publishing neither gets no route, that a closed listing stays out of the candidate read, that a board with no extractor still lands as a listing without facts, and that running the ingest twice duplicates nothing. Written when the local database did not exist and the ledger held 15,571 collected listings with nowhere to go.",
      "target": "tests/01_ingest"
    },
    {
      "path": "tests/03_match/candidates.test.ts",
      "stage": "03_match",
      "category": "contract",
      "protects": "The one read every downstream stage uses, against the real 166-table schema: all five boards are returned rather than anesl alone, a platform-apply route is carried the same as an email one, a route the board closed resolves to none, stored values are normalised on the way out, and a listing whose pay the board never stated is kept. Written after the product's only candidate reader was found hardcoded to anesl email, hiding 1,617 Serious Teachers jobs, and after a pay filter hid a further 1,032 of them."
    },
    {
      "path": "tests/02_extract/normalize.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "The standard every listing meets before anything downstream reads it: decoration stripped from titles, an empty country recovered from the location or title, a currency recovered from the country, a salary the extractor recorded in bare millions scaled, a per-lesson fee kept as a rate rather than becoming a monthly salary, an implausible weekly load discarded, repeated benefits collapsed, and a stated gender, age or nationality restriction recorded."
    },
    {
      "path": "tests/02_extract/seriousteachers-field-extraction.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "Deterministic extraction of the biggest board with no model call: the amount and currency from a Salary line, a negotiable salary recorded as stated rather than invented, no period claimed because the board states none, the seven degree spellings the board actually publishes, a teaching certificate kept apart from a degree, and learner groups and segment derived from the expertise list. Verified across all 6,243 live listings: 6,230 produce facts, zero fail the schema.",
      "target": "tests/02_extract"
    },
    {
      "path": "tests/02_extract/pay-period.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "The guard on the one place a model is allowed to decide something: which listings get asked about at all, that a quote must be copied from the advert, and that the quote must itself establish a period. A bare amount proves nothing and is refused. A period attached to a benefit is refused, because a monthly food stipend, a yearly return ticket and an annual flight are not pay. Every accepted and refused quote here was taken from a live listing during a run over the 208 ambiguous ones.",
      "target": "tests/02_extract"
    },
    {
      "path": "tests/02_extract/currency.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "Currency and period resolution: board codes such as RMB and NTD map to ISO, a country supplies the currency a listing omits, a period is read from the pay evidence when unstated, and an amount plausible as an hourly rate is never scaled into a monthly salary."
    },
    {
      "path": "tests/03_match/rank.test.ts",
      "stage": "03_match",
      "category": "contract",
      "protects": "Ranking reads canonical listings only and holds no correction logic: pay order with a deterministic tie-break, every priced listing ahead of every unpriced one, and one employer reposting at the same pay collapsing to a single row that records its reposts. A listing whose pay is unknown is marked and ordered last, never dropped, because dropping it hid two thirds of a board."
    },
    {
      "path": "tests/03_match/scoring.test.ts",
      "stage": "03_match",
      "category": "regression",
      "protects": "Scores compare across jobs. The score divided by however many facts a listing happened to state, so a sparse listing outranked a detailed one and ranking meant nothing. Pins the fixed-weight model, required outweighing preferred, partial credit for an unknown, and an ineligible job scoring zero so it can never outrank an eligible one."
    },
    {
      "path": "tests/02_extract/teacherhorizons-field-extraction.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "Deterministic extraction of TeacherHorizons source fields with no model call: learner group derived from the role, international-school segment, start date as an availability requirement, and subject as a skill. Pins that leadership roles publish no learner group and placeholder subjects are skipped rather than recorded. Verified against all 363 active listings."
    },
    {
      "path": "tests/02_extract/anesl-field-extraction.test.ts",
      "stage": "02_extract",
      "category": "contract",
      "protects": "Deterministic extraction of anesl source fields with no model call: degree level, minimum years, accepted nationalities, learner bands derived from the stated age range, market segment, benefits, monthly pay, and weekly hours. Covers the malformed values the board emits, and pins that an absent fact is omitted rather than invented. Verified against all 4,005 active anesl listings."
    }
  ]
}
